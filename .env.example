# Copy to .env and fill in. Never commit .env. See README.md for details.
# Camera account created in Tapo app: Advanced Settings > Camera Account
# (not the Tapo cloud account)
CAMERA_USER=
CAMERA_PASS=
# In LAN: the camera's IP and port 554. From a remote server: DDNS host + external port.
CAMERA_HOST=192.168.1.50
CAMERA_PORT=554
CAMERA_STREAM=stream1

# Seconds per recording segment (6h = 21600)
SEGMENT_SECONDS=21600
RECORD_DIR=recordings

# YouTube
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN=token.json
YOUTUBE_PRIVACY=private
PLAYLIST_PREFIX=Tapo

# Containers (Render, Docker): keep state on a persistent volume and pass the secrets as text
# DATA_DIR=/data
# YOUTUBE_TOKEN_JSON=         # contents of token.json
# YOUTUBE_CLIENT_SECRET_JSON= # contents of client_secret.json

# Where the daily video of tapo_motion.py goes: youtube (default) | webdav | local | rclone
# STORAGE=youtube
# WebDAV (Nextcloud, ownCloud, Synology): for Nextcloud use https://cloud.example.com/remote.php/dav/files/USER
# WEBDAV_URL=
# WEBDAV_USER=
# WEBDAV_PASS=           # for Nextcloud with 2FA: an app password
# WEBDAV_FOLDER=Tapo     # optional sub-folder
# A folder on this machine
# LOCAL_ROOT=/data/videos
# Any rclone remote (Mega, S3, Dropbox, ...): configure it first with `rclone config`
# RCLONE_REMOTE=mega
# RCLONE_CONFIG=         # optional path of the rclone config file
# RCLONE_FOLDER=Tapo     # optional sub-folder

# Only for tapo_motion.py (record around motion, one upload a day) - these are the defaults
# MOTION_PRE_SECONDS=30
# MOTION_POST_SECONDS=300
# MOTION_EXTEND_WITHIN=30
# MOTION_EVENTS=IsMotion,IsPeople
# UPLOAD_AT=21:00
# ONVIF_HOST=            # defaults to CAMERA_HOST; set the DDNS name when reaching the camera remotely
# ONVIF_PORT=2020        # the forwarded external port when remote

# ---------- Multi-account web app (python -m tapo_web run): ignored by the single-user programs ----------
# MULTIUSER=1
# PUBLIC_URL=https://tapo.example.com          # the HTTPS address users open; used for the Google and Nextcloud redirects
# SECRET_KEY=                                  # signs the session cookies: a long random string
# ENCRYPTION_KEY=                              # encrypts passwords and tokens: python -c "from tapo_web.crypto import Vault; print(Vault.generate_key())"
# SERVER_PUBLIC_IP=203.0.113.7                 # shown in the router guide: the only address allowed to reach the cameras
# PORT_RANGE=30000-39999                       # external ports handed out to cameras
# HOST=0.0.0.0
# PORT=8080
# ADMIN_USERNAME=                              # first start only: creates this local administrator if no user exists
# ADMIN_PASSWORD=
# LOCAL_LOGIN=true                             # sign in with a username and password stored here
# NEXTCLOUD_URL=https://cloud.example.com      # sign in with Nextcloud (its OAuth 2.0 clients, redirect PUBLIC_URL/auth/nextcloud/callback)
# NEXTCLOUD_CLIENT_ID=
# NEXTCLOUD_CLIENT_SECRET=
# NEXTCLOUD_ADMIN_GROUP=admin                  # members become administrators
# NEXTCLOUD_USER_GROUP=                        # members may use the service; unset = only administrators can sign in
# YOUTUBE_CLIENT_SECRET_JSON=                  # the shared Google project: a *Web application* client, redirect PUBLIC_URL/youtube/callback
# ALLOW_OWN_GOOGLE_CLIENT=false                # let a user link YouTube with their own Google project
# QUOTA_DAILY=10000                            # the Google project's daily YouTube quota (one full upload costs about 1700)
# UPLOAD_AT=21:00                              # first upload time; the next cameras follow UPLOAD_STAGGER_MINUTES later each
# UPLOAD_STAGGER_MINUTES=10
# MAX_CAMERAS_PER_USER=1
# MAX_CAMERAS_TOTAL=20
# RETENTION_DAYS=30                            # data of a deactivated user is deleted after this many days
# TRUSTED_PROXY_HOPS=0                        # set to 1 behind one reverse proxy (nginx, Caddy): real client addresses for the login limits
# ALLOW_PRIVATE_HOSTS=false                    # true only on a home network: lets users point cameras at private addresses
