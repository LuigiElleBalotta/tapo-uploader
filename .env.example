# Copy to .env and fill in. Never commit .env. See README.md for details.
# Camera account created in Tapo app: Advanced Settings > Camera Account
# (not the Tapo cloud account)
CAMERA_USER=
CAMERA_PASS=
# In LAN: the camera's IP and port 554. From a remote server: DDNS host + external port.
CAMERA_HOST=192.168.1.50
CAMERA_PORT=554
CAMERA_STREAM=stream1

# Seconds per recording segment (6h = 21600)
SEGMENT_SECONDS=21600
RECORD_DIR=recordings

# YouTube
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN=token.json
YOUTUBE_PRIVACY=private
PLAYLIST_PREFIX=Tapo
